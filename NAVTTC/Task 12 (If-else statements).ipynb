   ],
   "source": [
    "i = 20\n",
    "if(i<15):\n",
    "    print(\"i is smaller than 15\")\n",
    "    print(\"I am in if Block\")\n",
    "\n",
    "else:\n",
    "    print(\"i is greater than 15\")\n",
    "    print(\"I am in else block\")\n",
    "\n",
    "print(\"I am not in if and not in else block\")"
   ]
