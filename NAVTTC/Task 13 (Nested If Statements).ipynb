   "source": [
    "### Nested If Statement"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "598761d6-e26b-4fb7-b779-c4927c9bf1aa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "i is smaller than 15\n",
      "i is smaller than 12 too\n"
     ]
    }
   ],
   "source": [
    "i = 10\n",
    "if (i == 10):\n",
    "    if(i<15):\n",
    "        print(\"i is smaller than 15\")\n",
    "\n",
    "    if(i<12):\n",
    "        print(\"i is smaller than 12 too\")\n",
    "    else:\n",
    "        print(\"i is greater than 15\")"
   ]
  },
