   "source": [
    "### Calculating miles from filometers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "bab82219-04ef-4f28-874f-d24c76faaf04",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter value in kilometers:  35\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "35.00 kilometers in miles is 21.75\n"
     ]
    }
   ],
   "source": [
    "kilometers = float(input(\"Enter value in kilometers: \"))\n",
    "\n",
    "#conversion factor \n",
    "conv_fac = 0.621371\n",
    "\n",
    "#calculate miles\n",
    "\n",
    "miles = kilometers * conv_fac\n",
    "print(\"%0.2f kilometers in miles is %0.2f\" % (kilometers, miles))"
   ]
  },
